<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BenchmarkAgent</RootNamespace>
    <NoWarn>NU1605;NU1603</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CockroachDBLibraryRoot)/src/CockroachDB.DotNet.Abstractions/CockroachDB.DotNet.Abstractions.csproj" />
    <ProjectReference Include="$(CockroachDBLibraryRoot)/src/CockroachDB.DotNet.Core/CockroachDB.DotNet.Core.csproj" />
    <ProjectReference Include="$(CockroachDBLibraryRoot)/src/CockroachDB.DotNet.Cdc/CockroachDB.DotNet.Cdc.csproj" />
    <ProjectReference Include="$(CockroachDBLibraryRoot)/src/CockroachDB.DotNet.AI/CockroachDB.DotNet.AI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CockroachDBLibraryRoot Condition="'$(CockroachDBLibraryRoot)' == ''">$(MSBuildThisFileDirectory)../../../cockroachdb-dotnet-library</CockroachDBLibraryRoot>
  </PropertyGroup>

</Project>
